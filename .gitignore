# Vagrant instance state (per-instance .vagrant folders)
instances/

# Packaged boxes (large binary files)
*.box

# Vagrant temp files
.vagrant/

# Instance registry (machine-specific)
.vm-registry.json

# User config (machine-specific, contains personal paths)
vm.config.ps1

# SSH bridge (generated by setup-host-ssh.ps1, contains private key)
.ssh/
.bridge-config.json

# OS
Thumbs.db
.DS_Store
debug.log
